{
  "name": "sylunae-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable Sylunae Electron + Web application shell",
  "main": "out/main/index.js",
  "author": "Sylunae",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:desktop",
    "dev:web": "vite",
    "dev:desktop": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build:web && npm run build:desktop",
    "build": "npm-run-all build:web build:desktop",
    "build:web": "vite build",
    "build:desktop": "electron-vite build",
    "preview:web": "vite preview",
    "package:win": "npm run build:desktop && electron-builder --win nsis",
    "package:dir": "npm run build:desktop && electron-builder --dir"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "lucide-react": "^0.544.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-day-picker": "^9.11.0",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^41.0.2",
    "electron-builder": "^26.0.20",
    "electron-vite": "^5.0.0",
    "jsdom": "^27.0.0",
    "npm-run-all": "^4.1.5",
    "shadcn": "^4.0.0",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "studio.sylunae.framework",
    "productName": "Sylunae Framework",
    "directories": { "output": "release" },
    "files": ["out/**/*", "package.json"],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Sylunae-Framework-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
